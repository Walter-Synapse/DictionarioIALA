{
  "name": "dictionarioiala",
  "version": "1.8.0",
  "description": "Dictionario electronic e motor morphologic de Interlingua (IALA)",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "type-check": "tsc --project config/tsconfig.json --noEmit",
    "lint": "eslint --config config/eslint.config.js src/",
    "build": "tsc --project config/tsconfig.json && vite build --config config/vite.config.ts",
    "build:web": "tsc --project config/tsconfig.json && vite build --config config/vite.config.ts",
    "build:tauri": "tsc --project config/tsconfig.json && BUILD_TARGET=tauri vite build --config config/vite.config.ts",
    "dev": "vite --config config/vite.config.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.129.1"
  }
}
