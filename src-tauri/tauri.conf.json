{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DictionarioIALA",
  "version": "1.10.0",
  "identifier": "com.dictionarioiala.app",
  "build": {
    "frontendDist": "../dist_tauri",
    "devUrl": "http://localhost:1951",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Dictionario de Interlingua",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
